BOSON_API_KEY=
# Generate with: openssl rand -hex 32; use the same value in the server mod config.
HIGGS_BRIDGE_TOKEN=
HIGGS_HOST=127.0.0.1
HIGGS_PORT=8787
HIGGS_REALTIME_URL=wss://api.boson.ai/v1/realtime/
# Optional backend personality voices: approved preset or account-owned voice_<id>.
HIGGS_VOICE_WARM=chloe
HIGGS_VOICE_THOUGHTFUL=oliver
HIGGS_VOICE_STEADY=marcus
# Optional server-side memory and gossip settings (restart the game server).
HIGGS_MEMORY_MAX_PER_VILLAGER=64
HIGGS_MEMORY_TTL_HOURS=168
HIGGS_GOSSIP_RADIUS=16
HIGGS_GOSSIP_INTERVAL_SECONDS=10
HIGGS_GOSSIP_COOLDOWN_SECONDS=60
HIGGS_GOSSIP_MAX_HOPS=3
