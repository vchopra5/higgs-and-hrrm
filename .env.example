BOSON_API_KEY=
# Generate with: openssl rand -hex 32; use the same value in the server mod config.
HIGGS_BRIDGE_TOKEN=
HIGGS_HOST=127.0.0.1
HIGGS_PORT=8787
HIGGS_REALTIME_URL=wss://api.boson.ai/v1/realtime/
# Optional backend personality voices: approved preset or account-owned voice_<id>.
HIGGS_VOICE_WARM=chloe
HIGGS_VOICE_THOUGHTFUL=oliver
HIGGS_VOICE_STEADY=marcus
# Optional server-side memory and gossip settings (restart the game server).
HIGGS_MEMORY_MAX_PER_VILLAGER=64
HIGGS_MEMORY_TTL_HOURS=720
# Observed episodes (trades, gifts, quests…); important ones last 2-4x longer, summaries never expire.
HIGGS_MEMORY_EPISODE_DAYS=30
# After each conversation (two or more player turns), one short text-only Boson call writes a digest and the
# villager's relationship summary. Read by the backend.
HIGGS_CONSOLIDATION_ENABLED=true
HIGGS_GOSSIP_RADIUS=16
HIGGS_GOSSIP_INTERVAL_SECONDS=10
HIGGS_GOSSIP_COOLDOWN_SECONDS=60
HIGGS_GOSSIP_MAX_HOPS=3
# Optional villager-to-villager chatter (restart the game server). Each scene uses Boson
# realtime sessions for both villagers, so set ENABLED=false to save API usage.
HIGGS_CHATTER_ENABLED=true
HIGGS_CHATTER_INTERVAL_SECONDS=60
HIGGS_CHATTER_CHANCE_PERCENT=50
HIGGS_CHATTER_COOLDOWN_SECONDS=300
HIGGS_CHATTER_RADIUS=16
# Village area for names, entry titles and village reputation (blocks from the village centre).
HIGGS_VILLAGE_RADIUS=64
# A second villager within 4 blocks may join your conversation (uses a second Boson session).
HIGGS_COMPANION_ENABLED=true
# Browser village dashboard at http://localhost:8787/dashboard?token=<this> (backend). Leave empty to disable.
# Generate with: openssl rand -hex 16. Local connections only.
HIGGS_DASHBOARD_TOKEN=
# The dashboard opens in your browser when the backend starts; set to false to stop that.
HIGGS_DASHBOARD_OPEN=true
